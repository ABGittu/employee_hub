 "font_size": 14,
 "html": "<table width=\"100%\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" align=\"center\" style=\"width: 100%; margin: 0 auto; text-align: center; background-color: #f8fafc; padding: 20px 0;\">\n    <tr>\n        <td align=\"center\" valign=\"top\">\n            <!-- ID Card Outer Box -->\n            <table width=\"330\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" align=\"center\" style=\"width: 330px; max-width: 330px; margin: 0 auto; background-color: #ffffff; border: 2px solid #1e3a8a; border-radius: 12px; overflow: hidden; text-align: left; font-family: Arial, Helvetica, sans-serif;\">\n                \n                <!-- Header Banner (Solid Blue Background) -->\n                <tr>\n                    <td align=\"center\" valign=\"middle\" style=\"background-color: #1e3a8a; color: #ffffff; padding: 18px 12px; text-align: center;\">\n                        <div style=\"font-size: 10px; font-weight: bold; letter-spacing: 2px; text-transform: uppercase; color: #93c5fd; margin-bottom: 3px;\">ORGANIZATION IDENTITY CARD</div>\n                        <div style=\"font-size: 18px; font-weight: bold; letter-spacing: 0.5px; color: #ffffff;\">EMPLOYEE HUB</div>\n                    </td>\n                </tr>\n\n                <!-- Avatar Section (Table Centered with Solid Colors) -->\n                <tr>\n                    <td align=\"center\" valign=\"middle\" style=\"padding: 16px 12px 6px 12px; text-align: center; background-color: #ffffff;\">\n                        <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" align=\"center\" style=\"margin: 0 auto;\">\n                            <tr>\n                                <td align=\"center\" valign=\"middle\" style=\"width: 84px; height: 84px; background-color: #e2e8f0; border: 3px solid #1e3a8a; border-radius: 8px; text-align: center; vertical-align: middle;\">\n                                    {% if doc.profile_photo %}\n                                        <img src=\"{{ doc.profile_photo }}\" alt=\"{{ doc.full_name }}\" style=\"width: 78px; height: 78px; display: block; border-radius: 6px; object-fit: cover;\" />\n                                    {% else %}\n                                        <div style=\"font-size: 26px; font-weight: bold; color: #1e3a8a; line-height: 84px; text-align: center;\">{{ (doc.first_name[0] if doc.first_name else 'E') ~ (doc.last_name[0] if doc.last_name else 'H') }}</div>\n                                    {% endif %}\n                                </td>\n                            </tr>\n                        </table>\n                    </td>\n                </tr>\n\n                <!-- Employee Name & Designation -->\n                <tr>\n                    <td align=\"center\" valign=\"top\" style=\"padding: 4px 16px 10px 16px; text-align: center; background-color: #ffffff;\">\n                        <div style=\"font-size: 17px; font-weight: bold; color: #0f172a; margin-bottom: 2px;\">{{ doc.full_name or (doc.first_name ~ ' ' ~ doc.last_name) }}</div>\n                        <div style=\"font-size: 13px; font-weight: bold; color: #2563eb; margin-bottom: 6px;\">{{ doc.designation or 'Team Member' }}</div>\n                        <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" align=\"center\" style=\"margin: 0 auto;\">\n                            <tr>\n                                <td align=\"center\" valign=\"middle\" style=\"padding: 2px 10px; font-size: 11px; font-weight: bold; background-color: #ecfdf5; color: #065f46; border: 1px solid #a7f3d0; border-radius: 4px; text-align: center;\">\n                                    {{ doc.department or 'General' }}\n                                </td>\n                            </tr>\n                        </table>\n                    </td>\n                </tr>\n\n                <!-- Details Grid Table -->\n                <tr>\n                    <td style=\"padding: 6px 18px 12px 18px; background-color: #ffffff;\">\n                        <table width=\"100%\" border=\"0\" cellpadding=\"6\" cellspacing=\"0\" style=\"width: 100%; border-collapse: collapse; font-size: 11px;\">\n                            <tr>\n                                <td style=\"padding: 6px 0; color: #64748b; font-weight: bold; border-bottom: 1px solid #e2e8f0; width: 42%;\">Employee ID</td>\n                                <td style=\"padding: 6px 0; color: #0f172a; font-weight: bold; text-align: right; border-bottom: 1px solid #e2e8f0;\">{{ doc.name }}</td>\n                            </tr>\n                            <tr>\n                                <td style=\"padding: 6px 0; color: #64748b; font-weight: bold; border-bottom: 1px solid #e2e8f0;\">Date of Joining</td>\n                                <td style=\"padding: 6px 0; color: #0f172a; font-weight: 500; text-align: right; border-bottom: 1px solid #e2e8f0;\">{{ doc.get_formatted(\"date_of_joining\") or (doc.date_of_joining or '-') }}</td>\n                            </tr>\n                            <tr>\n                                <td style=\"padding: 6px 0; color: #64748b; font-weight: bold; border-bottom: 1px solid #e2e8f0;\">Email</td>\n                                <td style=\"padding: 6px 0; color: #0f172a; font-weight: 500; text-align: right; border-bottom: 1px solid #e2e8f0; word-break: break-all;\">{{ doc.employee_email or '-' }}</td>\n                            </tr>\n                            <tr>\n                                <td style=\"padding: 6px 0; color: #64748b; font-weight: bold; border-bottom: 1px solid #e2e8f0;\">Phone</td>\n                                <td style=\"padding: 6px 0; color: #0f172a; font-weight: 500; text-align: right; border-bottom: 1px solid #e2e8f0;\">{{ doc.phone or '-' }}</td>\n                            </tr>\n                            {% if doc.blood_group %}\n                            <tr>\n                                <td style=\"padding: 6px 0; color: #64748b; font-weight: bold; border-bottom: 1px solid #e2e8f0;\">Blood Group</td>\n                                <td style=\"padding: 6px 0; color: #dc2626; font-weight: bold; text-align: right; border-bottom: 1px solid #e2e8f0;\">{{ doc.blood_group }}</td>\n                            </tr>\n                            {% endif %}\n                        </table>\n                    </td>\n                </tr>\n\n                <!-- Barcode Simulation & Footer -->\n                <tr>\n                    <td align=\"center\" valign=\"middle\" style=\"padding: 10px 16px 14px 16px; border-top: 1px dashed #cbd5e1; text-align: center; background-color: #f8fafc;\">\n                        <div style=\"letter-spacing: 4px; font-family: 'Courier New', monospace; font-size: 15px; font-weight: bold; color: #334155;\">*{{ doc.name }}*</div>\n                        <div style=\"font-size: 8px; color: #64748b; margin-top: 4px; text-transform: uppercase; letter-spacing: 0.5px;\">Official Corporate Hub Credential &bull; Property of Sanskar</div>\n                    </td>\n                </tr>\n\n            </table>\n        </td>\n    </tr>\n</table>\n",
